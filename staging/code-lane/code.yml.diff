+            else if (line.startsWith('deleted file mode')) cur.status = 'removed';
+            else if (line.startsWith('rename from') || line.startsWith('similarity index')) cur.status = 'renamed';
+            else if (line.startsWith('Binary files') || line.startsWith('GIT binary patch')) cur.status = 'binary';
+          }
+          const report = { fileCount: files.length, files: files.slice(0, 4).map((f) => ({ ...f, path: f.path.slice(0, 200) })) };
+          appendFileSync(process.env.GITHUB_ENV, `CODE_PATCH_REPORT=${JSON.stringify(report)}\n`);
+          NODE
